msgstr "Рядок #{0}: {1} не є коректним полем показника. Перегляньте опис поля."

msgid "Row #{0}: {1} is required to create the Opening {2} Invoices"
msgstr "Рядок № {0}: {1} необхідний для створення початкових {2} рахунків-фактур"

msgid ""
"Row #{0}: {1} of {2} should be {3}. Please update the {1} or select a "
