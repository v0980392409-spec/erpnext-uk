msgid "Row #{idx}: {schedule_date} cannot be before {transaction_date}."
msgstr "Рядок #{idx}: {schedule_date} не може бути раніше за {transaction_date}."

msgid "Row #{}: Currency of {} - {} doesn't matches company currency."
msgstr "Рядок № {}: Валюта {} - {} не відповідає валюті компанії."

msgid "Row #{}: Either Party ID or Party Name is required"
msgstr "Рядок #{}: потрібен ідентифікатор або найменування контрагента"

msgid "Row #{}: Finance Book should not be empty since you're using multiple."
msgstr "Рядок #{}: фінансову книгу треба вказати, бо їх використовується кілька."

msgid "Row #{}: POS Invoice {} has been {}"
msgstr "Рядок № {}: Рахунок-фактура POS} {} був {}"

msgid "Row #{}: POS Invoice {} is not against customer {}"
msgstr "Рядок № {}: Рахунок-фактура POS} {} не проти клієнта {}"

msgid "Row #{}: POS Invoice {} is not submitted yet"
msgstr "Рядок № {}: Рахунок-фактура POS {} ще не надіслано"

msgid "Row #{}: Party ID is required"
msgstr "Рядок #{}: потрібен ідентифікатор контрагента"

msgid "Row #{}: Please assign task to a member."
msgstr "Рядок #{}: призначте завдання учаснику."

msgid "Row #{}: Please use a different Finance Book."
msgstr "Рядок #{}: використайте іншу фінансову книгу."

msgid ""
"Row #{}: Serial No {} cannot be returned since it was not transacted in "
