msgstr ""
"У конфігурації сайту бракує ключа адреси сервера push-ретрансляції "
"(`push_relay_server_url`)"

msgid "The Typst block could not render its template: {0}"
msgstr "Не вдалося обробити шаблон блоку Typst: {0}"

msgid "The Typst block in {0} does not compile: {1}"
msgstr "Блок Typst у {0} не компілюється: {1}"

