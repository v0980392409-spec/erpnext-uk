msgstr ""
"Рядок #{0}: повернена кількість номенклатури {1} не може перевищувати "
"доступну для повернення"

msgid "Row #{0}: Secondary Item Qty cannot be zero"
msgstr "Рядок #{0}: кількість супутньої позиції не може дорівнювати нулю"

msgid ""
"Row #{0}: Selling rate for item {1} is lower than its {2}.\n"
"\t\t\t\t\tSelling {3} should be atleast {4}.<br><br>Alternatively,\n"
"\t\t\t\t\tyou can disable '{5}' in {6} to bypass\n"
"\t\t\t\t\tthis validation."
msgstr ""
"Рядок #{0}: ціна продажу номенклатури {1} нижча за її {2}.\n"
"\t\t\t\t\t{3} продажу має бути щонайменше {4}.<br><br>Або\n"
"\t\t\t\t\tвимкніть «{5}» у {6}, щоб оминути\n"
"\t\t\t\t\tцю перевірку."

msgid "Row #{0}: Sequence ID must be {1} or {2} for Operation {3}."
msgstr "Рядок #{0}: для операції {3} порядковий номер має бути {1} або {2}."

msgid "Row #{0}: Serial No {1} does not belong to Batch {2}"
msgstr "Рядок № {0}: Серійний номер {1} не належить до партії {2}"

msgid ""
"Row #{0}: Serial No {1} for Item {2} is not available in {3} {4} or might"
" be reserved in another {5}."
msgstr ""
"Рядок #{0}: серійного номера {1} номенклатури {2} немає в {3} {4} або "
"його зарезервовано в іншому {5}."

