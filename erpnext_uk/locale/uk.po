msgstr "У рядку {0} відібрано менше, ніж потрібно: бракує ще {1} {2}."

msgid "Row {0}# Item {1} not found in 'Raw Materials Supplied' table in {2} {3}"
msgstr "Рядок {0}: номенклатури {1} немає в таблиці переданої сировини в {2} {3}"

msgid "Row {0}: Accepted Qty and Rejected Qty can't be zero at the same time."
msgstr ""
"Рядок {0}: прийнята і відхилена кількість не можуть бути нульовими "
"одночасно."

msgid "Row {0}: Account {1} and Party Type {2} have different account types"
msgstr "Рядок {0}: рахунок {1} і тип контрагента {2} мають різні типи рахунків"

msgid "Row {0}: Activity Type is mandatory."
msgstr "Рядок {0}: Тип робіт є обов'язковим."

msgid "Row {0}: Advance against Customer must be credit"
msgstr "Рядок {0}: Сума авансу від клієнта має бути в колонці «Кредит»"

msgid "Row {0}: Advance against Supplier must be debit"
msgstr "Рядок {0}: аванс постачальнику має бути дебетом"

msgid ""
"Row {0}: Allocated amount {1} must be less than or equal to invoice "
