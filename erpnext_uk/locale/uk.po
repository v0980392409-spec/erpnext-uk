msgstr ""
"Рядок #{0}: немає запасу для резервування номенклатури {1} за партією {2}"
" на складі {3}."

msgid ""
"Row #{0}: Stock not available to reserve for the Item {1} in Warehouse "
"{2}."
msgstr "Рядок #{0}: немає запасу для резервування номенклатури {1} на складі {2}."

msgid "Row #{0}: Stock quantity {1} ({2}) for item {3} cannot exceed {4}"
msgstr ""
"Рядок #{0}: складська кількість {1} ({2}) номенклатури {3} не може "
