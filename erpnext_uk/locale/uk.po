msgid "Row {0}: Item {1} is not allowed for {2} {3}."
msgstr "Рядок {0}: номенклатуру {1} не дозволено для {2} {3}."

msgid "Row {0}: Item {1} must be a stock item."
msgstr "Рядок {0}: Номенклатура {1} має бути складською."

msgid "Row {0}: Item {1} must be a subcontracted item."
msgstr "Рядок {0}: номенклатура {1} має бути субпідрядною."

msgid "Row {0}: Item {1} must be linked to a {2}."
msgstr "Рядок {0}: номенклатуру {1} треба пов’язати з {2}."

msgid "Row {0}: Item {1}'s quantity cannot be higher than the available quantity."
msgstr "Рядок {0}: Кількість номенклатури {1} не може бути більшою за доступну."

msgid "Row {0}: Operation time should be greater than 0 for operation {1}"
msgstr "Рядок {0}: час операції {1} має бути більшим за 0"

msgid "Row {0}: Packed Qty must be equal to {1} Qty."
msgstr "Рядок {0}: Кількість в упаковці має дорівнювати кількості {1}."

msgid "Row {0}: Packing Slip is already created for Item {1}."
msgstr "Рядок {0}: Пакувальну накладну для номенклатури {1} вже створено."

msgid "Row {0}: Party / Account does not match with {1} / {2} in {3} {4}"
msgstr "Рядок {0}: Контрагент / Рахунок не збігається з {1} / {2} у {3} {4}"

msgid ""
"Row {0}: Party Type and Party is required for Receivable / Payable "
"account {1}"
msgstr ""
"Рядок {0}: Тип контрагента та контрагент є обов'язковими для рахунку "
"дебіторської/кредиторської заборгованості {1}"

msgid "Row {0}: Payment Term is mandatory"
msgstr "Рядок {0}: умова оплати обов’язкова"

msgid ""
"Row {0}: Payment against Sales/Purchase Order should always be marked as "
