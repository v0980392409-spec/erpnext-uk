msgstr ""
"Рядок № {0}: Будь ласка, введіть кількість для номенклатури {1}, оскільки"
" вона не дорівнює нулю."

msgid "Row # {0}: Rate cannot be greater than the rate used in {1} {2}"
msgstr "Рядок № {0}: Ціна не може бути більшою за ціну, використану в {1} {2}"

msgid "Row # {0}: Returned Item {1} does not exist in {2} {3}"
msgstr "Рядок № {0}: Повернена номенклатура {1} відсутня в {2} {3}"

msgid "Row #1: Sequence ID must be 1 for Operation {0}."
msgstr "Рядок #1: для операції {0} порядковий номер має бути 1."

msgid "Row #{0} (Payment Table): Amount must be negative"
msgstr "Рядок # {0} (Таблиця платежів): сума має бути від'ємною"

msgid "Row #{0} (Payment Table): Amount must be positive"
msgstr "Рядок # {0} (Таблиця платежів): сума повинна бути позитивною"

msgid ""
"Row #{0}: % of Component Cost needs a BOM secondary item. Choose "
"Valuation Rate or Manual for {1}."
msgstr ""
"Рядок #{0}: «% вартості компонента» потребує супутньої номенклатури "
"специфікації. Виберіть «Собівартість» або «Вручну» для {1}."

msgid "Row #{0}: '{1}' cannot be used to search items."
msgstr "Рядок #{0}: «{1}» не можна використовувати для пошуку номенклатури."

msgid "Row #{0}: '{1}' does not match {2}."
msgstr "Рядок #{0}: «{1}» не відповідає {2}."

msgid "Row #{0}: '{1}' is not a valid field of {2}."
msgstr "Рядок #{0}: «{1}» не є дійсним полем {2}."

msgid ""
"Row #{0}: A reorder entry already exists for warehouse {1} with reorder "
"type {2}."
msgstr "Рядок #{0}: для складу {1} уже є правило дозамовлення з типом {2}."

msgid "Row #{0}: Acceptance Criteria Formula is incorrect."
msgstr "Рядок #{0}: формула критерію прийняття хибна."

msgid "Row #{0}: Acceptance Criteria Formula is required."
msgstr "Рядок #{0}: потрібна формула критерію прийняття."

msgid "Row #{0}: Accepted Warehouse and Rejected Warehouse cannot be same"
msgstr "Рядок #{0}: склад прийнятого і склад відхиленого не можуть збігатися"

msgid "Row #{0}: Accepted Warehouse is mandatory for the accepted Item {1}"
msgstr "Рядок #{0}: «Прийнятий склад» обов'язковий для прийнятої номенклатури {1}"

msgid "Row #{0}: Account {1} does not belong to company {2}"
msgstr "Рядок № {0}: рахунок {1} не належить організації {2}"

msgid ""
"Row #{0}: Allocated Amount cannot be greater than Outstanding Amount of "
"Payment Request {1}"
msgstr ""
"Рядок #{0}: розподілена сума не може перевищувати заборгованість за "
"запитом на оплату {1}"

msgid "Row #{0}: Allocated Amount cannot be greater than outstanding amount."
msgstr "Рядок # {0}: Виділена сума не може бути більше суми заборгованості."

msgid ""
"Row #{0}: Allocated amount:{1} is greater than outstanding amount:{2} for"
" Payment Term {3}"
msgstr ""
"Рядок #{0}: розподілена сума {1} більша за заборгованість {2} за умовою "
"оплати {3}"

msgid "Row #{0}: Amount must be a positive number"
msgstr "Рядок #{0}: сума має бути додатною"

msgid "Row #{0}: Asset {1} cannot be sold, it is already {2}"
msgstr "Рядок #{0}: актив {1} не можна продати — він уже {2}"

msgid "Row #{0}: Asset {1} is already sold"
msgstr "Рядок #{0}: актив {1} уже продано"

msgid "Row #{0}: BOM is not specified for subcontracting item {0}"
msgstr "Рядок #{0}: для субпідрядної номенклатури {0} не вказано специфікацію"

msgid "Row #{0}: BOM not found for FG Item {1}"
msgstr "Рядок #{0}: специфікацію не знайдено для готової номенклатури {1}"

msgid "Row #{0}: Batch No {1} is already selected."
msgstr "Рядок #{0}: партію {1} уже вибрано."

msgid ""
"Row #{0}: Batch No(s) {1} is not a part of the linked Subcontracting "
"Inward Order. Please select valid Batch No(s)."
msgstr ""
"Рядок #{0}: партій {1} немає у пов’язаному вхідному замовленні "
"субпідряду. Виберіть коректні партії."

msgid "Row #{0}: Cannot allocate more than {1} against payment term {2}"
msgstr "Рядок #{0}: за умовою оплати {2} не можна розподілити більше ніж {1}"

msgid ""
"Row #{0}: Cannot cancel this Manufacturing Stock Entry as billed quantity"
" of Item {1} cannot be greater than consumed quantity."
msgstr ""
"Рядок #{0}: Неможливо скасувати цей виробничий рух ТМЦ, оскільки "
"кількість номенклатури {1} у рахунку не може бути більшою за спожиту."

msgid ""
"Row #{0}: Cannot cancel this Manufacturing Stock Entry as quantity of "
"Secondary Item {1} produced cannot be less than quantity delivered."
msgstr ""
"Рядок #{0}: Неможливо скасувати цей виробничий рух ТМЦ, оскільки "
"вироблена кількість супутньої номенклатури {1} не може бути меншою за "
"відвантажену."

msgid ""
"Row #{0}: Cannot cancel this Stock Entry as returned quantity cannot be "
"greater than delivered quantity for Item {1} in the linked Subcontracting"
" Inward Order"
msgstr ""
"Рядок #{0}: Неможливо скасувати цей рух ТМЦ, оскільки повернена кількість"
" не може бути більшою за відвантажену для номенклатури {1} у пов'язаному "
"вхідному замовленні на субпідряд"

msgid ""
"Row #{0}: Cannot create entry with different taxable AND withholding "
"document links."
msgstr ""
"Рядок #{0}: не можна створити запис із різними посиланнями на "
"оподатковуваний документ і документ утримання."

msgid "Row #{0}: Cannot delete item {1} which has already been billed."
msgstr ""
"Рядок #{0}: не можна видалити номенклатуру {1}, за яку вже виставлено "
"рахунок."

msgid "Row #{0}: Cannot delete item {1} which has already been delivered"
msgstr "Рядок #{0}: не можна видалити номенклатуру {1}, яку вже відвантажено"

msgid "Row #{0}: Cannot delete item {1} which has already been received"
msgstr "Рядок #{0}: не можна видалити номенклатуру {1}, яку вже отримано"

msgid "Row #{0}: Cannot delete item {1} which has work order assigned to it."
msgstr ""
"Рядок #{0}: не можна видалити номенклатуру {1}, якій призначено "
"замовлення на виробництво."

msgid ""
"Row #{0}: Cannot delete item {1} which is already ordered against this "
"Sales Order."
msgstr ""
"Рядок #{0}: Неможливо видалити номенклатуру {1}, яку вже замовлено за цим"
" замовленням на продаж."

msgid ""
"Row #{0}: Cannot return {1} of Batch {2}, only {3} was delivered and not "
"returned yet."
msgstr ""
"Рядок #{0}: не можна повернути {1} з партії {2} — відвантажено й ще не "
"повернено лише {3}."

msgid ""
"Row #{0}: Cannot set Rate if the billed amount is greater than the amount"
" for Item {1}."
msgstr ""
"Рядок #{0}: Неможливо встановити ціну, якщо сума рахунку перевищує суму "
"для номенклатури {1}."

msgid ""
"Row #{0}: Cannot transfer more than Required Qty {1} for Item {2} against"
" Job Card {3}"
msgstr ""
"Рядок #{0}: Неможливо перемістити більше потрібної кількості {1} для "
"номенклатури {2} за робочою карткою {3}"

msgid ""
"Row #{0}: Cannot transfer {1} {2} of Item {3}. Maximum transferable "
"quantity is {4} {2}."
msgstr ""
"Рядок #{0}: не можна передати {1} {2} номенклатури {3}. Максимальна "
"кількість до передачі — {4} {2}."

msgid ""
"Row #{0}: Child Item should not be a Product Bundle. Please remove Item "
"{1} and Save"
msgstr ""
"Рядок #{0}: дочірня номенклатура не може бути набором продуктів. Вилучіть"
" номенклатуру {1} і збережіть"

msgid ""
"Row #{0}: Company {1} does not match with the company {2} in Serial and "
"Batch Bundle {3}."
msgstr ""
"Рядок #{0}: організація {1} не збігається з організацією {2} у наборі "
"серійних номерів і партій {3}."

msgid "Row #{0}: Consumed Asset {1} cannot be Draft"
msgstr "Рядок #{0}: спожитий актив {1} не може бути чернеткою"

msgid "Row #{0}: Consumed Asset {1} cannot be cancelled"
msgstr "Рядок #{0}: спожитий актив {1} не може бути скасованим"

msgid "Row #{0}: Consumed Asset {1} cannot be the same as the Target Asset"
msgstr "Рядок #{0}: спожитий актив {1} не може збігатися з цільовим активом"

msgid "Row #{0}: Consumed Asset {1} cannot be {2}"
msgstr "Рядок #{0}: спожитий актив {1} не може бути {2}"

msgid "Row #{0}: Consumed Asset {1} does not belong to company {2}"
msgstr "Рядок #{0}: спожитий актив {1} не належить організації {2}"

msgid "Row #{0}: Cost Center {1} does not belong to company {2}"
msgstr "Рядок № {0}: Центр витрат {1} не належить організації {2}"

msgid ""
"Row #{0}: Could not find enough {1} entries to match. Remaining amount: "
"{2}"
msgstr ""
"Рядок #{0}: не знайдено достатньо записів {1} для зіставлення. Залишок "
"суми: {2}"

msgid ""
"Row #{0}: Cumulative threshold cannot be less than Single Transaction "
"threshold"
msgstr ""
"Рядок #{0}: накопичувальний поріг не може бути меншим за поріг однієї "
"операції"

msgid ""
"Row #{0}: Customer Provided Item {1} against Subcontracting Inward Order "
"Item {2} ({3}) cannot be added multiple times."
msgstr ""
"Рядок #{0}: давальницьку номенклатуру {1} за номенклатурою вхідного "
"замовлення субпідряду {2} ({3}) не можна додавати кілька разів."

msgid ""
"Row #{0}: Customer Provided Item {1} cannot be added multiple times in "
"the Subcontracting Inward process."
msgstr ""
"Рядок #{0}: Давальницьку номенклатуру {1} не можна додавати кілька разів "
"у процесі вхідного субпідряду."

msgid "Row #{0}: Customer Provided Item {1} cannot be added multiple times."
msgstr "Рядок #{0}: давальницьку номенклатуру {1} не можна додавати кілька разів."

msgid ""
"Row #{0}: Customer Provided Item {1} does not exist in the Required Items"
" table linked to the Subcontracting Inward Order."
msgstr ""
"Рядок #{0}: давальницької номенклатури {1} немає в таблиці потрібної "
"номенклатури, пов'язаній із вхідним замовленням субпідряду."

msgid ""
"Row #{0}: Customer Provided Item {1} exceeds quantity available through "
"Subcontracting Inward Order"
msgstr ""
"Рядок #{0}: Давальницька номенклатура {1} перевищує кількість, доступну "
"за вхідним замовленням на субпідряд"

msgid ""
"Row #{0}: Customer Provided Item {1} has insufficient quantity in the "
"Subcontracting Inward Order. Available quantity is {2}."
msgstr ""
"Рядок #{0}: Давальницької номенклатури {1} недостатньо у вхідному "
"замовленні на субпідряд. Доступна кількість {2}."

msgid ""
"Row #{0}: Customer Provided Item {1} is not a part of Subcontracting "
"Inward Order {2}"
msgstr ""
"Рядок #{0}: Давальницька номенклатура {1} не входить до вхідного "
"замовлення на субпідряд {2}"

msgid "Row #{0}: Customer Provided Item {1} is not a part of Work Order {2}"
msgstr ""
"Рядок #{0}: давальницької номенклатури {1} немає в замовленні на "
"виробництво {2}"

msgid "Row #{0}: Dates overlapping with other row in group {1}"
msgstr "Рядок #{0}: дати перетинаються з іншим рядком у групі {1}"

msgid "Row #{0}: Default BOM not found for FG Item {1}"
msgstr ""
"Рядок #{0}: специфікацію за замовчуванням не знайдено для готової "
"номенклатури {1}"

msgid ""
"Row #{0}: Delivery of Item {1} is ensured by produced Serial No, but no "
"Serial No is reserved against Sales Order {2}. Reserve the produced "
"Serial Nos from the Sales Order."
msgstr ""
"Рядок #{0}: відвантаження номенклатури {1} забезпечується виробленими "
"серійними номерами, але за замовленням на продаж {2} жодного не "
"зарезервовано. Зарезервуйте вироблені серійні номери із замовлення."

msgid "Row #{0}: Depreciation Start Date is required"
msgstr "Рядок #{0}: потрібна дата початку амортизації"

msgid "Row #{0}: Duplicate entry in References {1} {2}"
msgstr "Рядок # {0}: повторювані записи в посиланнях {1} {2}"

msgid "Row #{0}: Expected Delivery Date cannot be before Purchase Order Date"
msgstr ""
"Рядок # {0}: очікувана дата доставки не може передувати даті замовлення "
"на купівлю"

msgid "Row #{0}: Expense Account not set for the Item {1}. {2}"
msgstr "Рядок #{0}: для номенклатури {1} не задано рахунок витрат. {2}"

msgid ""
"Row #{0}: Expense account {1} is not valid for Purchase Invoice {2}. Only"
" expense accounts from non-stock items are allowed."
msgstr ""
"Рядок #{0}: Рахунок витрат {1} недійсний для рахунку-фактури "
"постачальника {2}. Дозволено лише рахунки витрат нескладської "
"номенклатури."

msgid ""
"Row #{0}: FG / Semi FG Item is required for the operation {1} as 'Track "
"Semi Finished Goods' is enabled."
msgstr ""
"Рядок #{0}: для операції {1} потрібна номенклатура готової продукції / "
"напівфабрикату, бо ввімкнено «Відстежувати напівфабрикати»."

msgid "Row #{0}: Finished Good Item Qty can not be zero"
msgstr "Рядок #{0}: Кількість готової номенклатури не може дорівнювати нулю"

msgid "Row #{0}: Finished Good Item is not specified for service item {1}"
msgstr "Рядок #{0}: для номенклатури послуги {1} не вказано готову номенклатуру"

msgid ""
"Row #{0}: Finished Good Item {1} cannot be added in the Secondary Items "
"table."
msgstr ""
"Рядок #{0}: Готову номенклатуру {1} не можна додати до таблиці «Супутня "
"номенклатура»."

msgid "Row #{0}: Finished Good Item {1} must be a sub-contracted item"
msgstr "Рядок #{0}: готова продукція {1} має бути субпідрядною номенклатурою"

msgid "Row #{0}: Finished Good must be {1}"
msgstr "Рядок #{0}: готовою продукцією має бути {1}"

msgid "Row #{0}: Finished Good reference is mandatory for Secondary Item {1}."
msgstr ""
"Рядок #{0}: посилання на готову продукцію обов'язкове для супутньої "
"номенклатури {1}."

msgid "Row #{0}: For Customer Provided Item {1}, Source Warehouse must be {2}"
msgstr "Рядок #{0}: Для давальницької номенклатури {1} склад-джерело має бути {2}"

msgid ""
"Row #{0}: For {1}, you can select reference document only if account gets"
" credited"
msgstr ""
"Рядок #{0}: для {1} документ-підставу можна вибрати, лише якщо рахунок "
"кредитується"

msgid ""
"Row #{0}: For {1}, you can select reference document only if account gets"
" debited"
msgstr ""
"Рядок #{0}: для {1} документ-підставу можна вибрати, лише якщо рахунок "
"дебетується"

msgid "Row #{0}: Frequency of Depreciation must be greater than zero"
msgstr "Рядок #{0}: періодичність амортизації має бути більшою за нуль"

msgid "Row #{0}: From Date cannot be before To Date"
msgstr "Рядок #{0}: дата з не може бути раніше дати до"

msgid "Row #{0}: From Time and To Time fields are required"
msgstr "Рядок #{0}: потрібні поля «Час з» і «Час до»"

msgid "Row #{0}: Item added"
msgstr "Рядок #{0}: номенклатуру додано"

msgid "Row #{0}: Item {1} cannot be transferred more than {2} against {3} {4}"
msgstr "Рядок #{0}: номенклатуру {1} не можна передати більше ніж {2} за {3} {4}"

msgid "Row #{0}: Item {1} does not exist"
msgstr "Рядок #{0}: номенклатури {1} не існує"

msgid ""
"Row #{0}: Item {1} has Operation {2}. Set a Routing to create BOMs with "
"operations."
msgstr ""
"Рядок #{0}: номенклатура {1} має операцію {2}. Укажіть технологічний "
"маршрут, щоб створювати специфікації з операціями."

msgid ""
"Row #{0}: Item {1} has been picked, please reserve stock from the Pick "
"List."
msgstr ""
"Рядок #{0}: Номенклатуру {1} відібрано, будь ласка, зарезервуйте запас за"
" листом відбору."

msgid "Row #{0}: Item {1} has no stock in warehouse {2}."
msgstr "Рядок #{0}: Номенклатури {1} немає в наявності на складі {2}."

msgid "Row #{0}: Item {1} has zero rate but '{2}' is not enabled."
msgstr "Рядок #{0}: у номенклатури {1} нульова ціна, а «{2}» не ввімкнено."

msgid "Row #{0}: Item {1} in warehouse {2}: Available {3}, Needed {4}."
msgstr "Рядок #{0}: Номенклатура {1} на складі {2}: доступно {3}, потрібно {4}."

msgid ""
"Row #{0}: Item {1} is already added with the same Type in the Secondary "
"Items table."
msgstr ""
"Рядок #{0}: номенклатуру {1} вже додано з тим самим типом у таблиці "
"супутньої номенклатури."

msgid "Row #{0}: Item {1} is not a Customer Provided Item."
msgstr "Рядок #{0}: номенклатура {1} не є давальницькою."

msgid ""
"Row #{0}: Item {1} is not a Serialized/Batched Item. It cannot have a "
"Serial No/Batch No against it."
msgstr ""
"Рядок #{0}: номенклатура {1} не є серійною чи партійною. Їй не можна "
"призначити серійний номер або номер партії."

msgid "Row #{0}: Item {1} is not a part of Subcontracting Inward Order {2}"
msgstr "Рядок #{0}: номенклатури {1} немає у вхідному замовленні субпідряду {2}"

msgid "Row #{0}: Item {1} is not a service item"
msgstr "Рядок #{0}: номенклатура {1} не є послугою"

msgid "Row #{0}: Item {1} is not a stock item"
msgstr "Рядок #{0}: Номенклатура {1} не є складською"

msgid ""
"Row #{0}: Item {1} is not part of the source manufacture entry and cannot"
" be added to this disassembly."
msgstr ""
"Рядок #{0}: номенклатура {1} не входить до вихідного запису виробництва, "
"тож її не можна додати до цього розбирання."

msgid ""
"Row #{0}: Item {1} mismatch. Changing of item code is not permitted, add "
"another row instead."
msgstr ""
"Рядок #{0}: невідповідність номенклатури {1}. Змінювати код номенклатури "
"заборонено — додайте інший рядок."

msgid "Row #{0}: Item {1} mismatch. Changing of item code is not permitted."
msgstr ""
"Рядок #{0}: невідповідність номенклатури {1}. Змінювати код номенклатури "
"заборонено."

msgid ""
"Row #{0}: Item {1} quantity ({2} in stock UOM) does not match the "
"quantity derived from the source ({3}). Do not change the UOM, conversion"
" factor or quantity of disassembly rows."
msgstr ""
"Рядок #{0}: Кількість номенклатури {1} ({2} у складській одиниці виміру) "
"не відповідає кількості, отриманій із джерела ({3}). Не змінюйте одиницю "
"виміру, коефіцієнт перерахунку або кількість у рядках розбирання."

msgid ""
"Row #{0}: Journal Entry {1} does not have account {2} or already matched "
"against another voucher"
msgstr ""
"Рядок #{0}: запис журналу {1} не має рахунку {2} або вже зіставлено з "
"іншим документом"

msgid "Row #{0}: Next Depreciation Date cannot be before Available-for-use Date"
msgstr ""
"Рядок #{0}: наступна дата амортизації не може бути раніше дати готовності"
" до використання"

msgid "Row #{0}: Next Depreciation Date cannot be before Purchase Date"
msgstr "Рядок #{0}: наступна дата амортизації не може бути раніше дати придбання"

msgid "Row #{0}: Not allowed to change Supplier as Purchase Order already exists"
msgstr ""
"Рядок №{0}: не можна змінювати постачальника, оскільки замовлення на "
"закупівлю вже існує"

msgid "Row #{0}: Only {1} available to reserve for the Item {2}"
msgstr "Рядок #{0}: для номенклатури {2} доступно для резервування лише {1}"

msgid ""
"Row #{0}: Opening Accumulated Depreciation must be less than or equal to "
"{1}"
msgstr "Рядок #{0}: початкова накопичена амортизація має бути не більшою за {1}"

msgid ""
"Row #{0}: Operation {1} is not completed for {2} qty of finished goods in"
" Work Order {3}. Please update operation status via Job Card {4}."
msgstr ""
"Рядок #{0}: Операцію {1} не завершено для {2} кількості готової продукції"
" в робочому замовленні {3}. Будь ласка, оновіть статус операції через "
"робочу картку {4}."

msgid ""
"Row #{0}: Overconsumption of Customer Provided Item {1} against Work "
"Order {2} is not allowed in the Subcontracting Inward process."
msgstr ""
"Рядок #{0}: Перевитрата давальницької номенклатури {1} за замовленням на "
"виробництво {2} не дозволена в процесі вхідного субпідряду."

msgid "Row #{0}: Planned Qty must be greater than 0 for Item {1}."
msgstr ""
"Рядок #{0}: запланована кількість для номенклатури {1} має бути більшою "
"за 0."

msgid "Row #{0}: Please select Item Code in Assembly Items"
msgstr "Рядок #{0}: виберіть код номенклатури у номенклатурах збірки"

msgid "Row #{0}: Please select the BOM No in Assembly Items"
msgstr "Рядок #{0}: виберіть номер специфікації у номенклатурах збірки"

msgid ""
"Row #{0}: Please select the Finished Good Item against which this "
"Customer Provided Item will be used."
msgstr ""
"Рядок #{0}: виберіть готову продукцію, для якої піде ця давальницька "
"номенклатура."

msgid "Row #{0}: Please select the Sub Assembly Warehouse"
msgstr "Рядок #{0}: виберіть склад підзбірки"

msgid "Row #{0}: Please set reorder quantity"
msgstr "Рядок №{0}: вкажіть кількість для повторного замовлення"

msgid ""
"Row #{0}: Please update deferred revenue/expense account in item row or "
"default account in company master"
msgstr ""
"Рядок #{0}: задайте рахунок доходів або витрат майбутніх періодів у рядку"
" позиції чи типовий рахунок у картці організації"

msgid ""
"Row #{0}: Process Loss Percentage should be less than 100% for {1} Item "
"{2}"
msgstr ""
"Рядок #{0}: відсоток втрат процесу має бути меншим за 100% для "
"номенклатури {1} {2}"

msgid "Row #{0}: Qty increased by {1}"
msgstr "Рядок #{0}: кількість збільшено на {1}"

msgid "Row #{0}: Qty must be a positive number"
msgstr "Рядок #{0}: кількість має бути додатною"

msgid ""
"Row #{0}: Qty should be less than or equal to Available Qty to Reserve "
"(Actual Qty - Reserved Qty) {1} for Iem {2} against Batch {3} in "
"Warehouse {4}."
msgstr ""
"Рядок #{0}: Кількість має бути меншою або дорівнювати доступній для "
"резервування кількості (фактична кількість - зарезервована кількість) {1}"
" для товару {2} у партії {3} на складі {4}."

msgid "Row #{0}: Quality Inspection is required for Item {1}"
msgstr "Рядок #{0}: Для номенклатури {1} потрібна перевірка якості"

msgid "Row #{0}: Quality Inspection {1} is not submitted for the item: {2}"
msgstr "Рядок #{0}: перевірку якості {1} для номенклатури {2} не проведено"

msgid "Row #{0}: Quality Inspection {1} was rejected for item {2}"
msgstr "Рядок #{0}: Перевірку якості {1} відхилено для номенклатури {2}"

msgid ""
"Row #{0}: Quantity cannot be a non-positive number. Please increase the "
"quantity or remove the Item {1}"
msgstr ""
"Рядок #{0}: Кількість має бути додатним числом. Збільште кількість або "
"видаліть позицію {1}"

msgid "Row #{0}: Quantity for Item {1} cannot be zero."
msgstr "Рядок #{0}: Кількість для номенклатури {1} не може бути нульовою."

msgid "Row #{0}: Quantity must be greater than 0 for Item {1}"
msgstr "Рядок #{0}: Кількість для номенклатури {1} має бути більшою за 0"

msgid ""
"Row #{0}: Quantity of Item {1} cannot be more than {2} {3} against "
"Subcontracting Inward Order {4}"
msgstr ""
"Рядок #{0}: Кількість номенклатури {1} не може бути більшою за {2} {3} за"
" вхідним замовленням на субпідряд {4}"

msgid "Row #{0}: Quantity to reserve for the Item {1} should be greater than 0."
msgstr ""
"Рядок #{0}: Кількість для резервування номенклатури {1} має бути більшою "
"за 0."

msgid "Row #{0}: Rate must be same as {1}: {2} ({3} / {4})"
msgstr "Рядок #{0}: Ціна має бути такою ж, як {1}: {2} ({3} / {4})"

msgid ""
"Row #{0}: Reading {1} {2} is not a valid number in the {3} number format."
" Use {4} as the decimal separator."
msgstr ""
"Рядок #{0}: показник {1} {2} не є коректним числом у форматі {3}. "
"Використовуйте {4} як десятковий роздільник."

msgid ""
"Row #{0}: Reference Document Type must be one of Purchase Order, Purchase"
" Invoice or Journal Entry"
msgstr ""
"Рядок #{0}: тип документа-підстави має бути одним із: замовлення на "
"купівлю, рахунок-фактура на покупку або запис журналу"

msgid ""
"Row #{0}: Reference Document Type must be one of Sales Order, Sales "
"Invoice, Journal Entry or Dunning"
msgstr ""
"Рядок #{0}: тип документа-підстави має бути одним із: замовлення на "
"продаж, рахунок-фактура (продаж), запис журналу або нагадування"

msgid "Row #{0}: Rejected Qty cannot be set for Secondary Item {1}."
msgstr ""
"Рядок #{0}: для супутньої номенклатури {1} відхилену кількість задати не "
"можна."

msgid "Row #{0}: Rejected Warehouse is mandatory for the rejected Item {1}"
msgstr ""
"Рядок #{0}: «Відхилений склад» обов'язковий для відхиленої номенклатури "
"{1}"

msgid ""
"Row #{0}: Repair cost {1} exceeds available amount {2} for Purchase "
"Invoice {3} and Account {4}"
msgstr ""
"Рядок #{0}: вартість ремонту {1} перевищує доступну суму {2} за рахунком "
"на покупку {3} і рахунком {4}"

msgid "Row #{0}: Return Against is required for returning asset"
msgstr "Рядок #{0}: щоб повернути актив, потрібен документ-підстава повернення"

msgid ""
"Row #{0}: Returned quantity cannot be greater than available quantity for"
" Item {1}"
msgstr ""
"Рядок #{0}: Повернена кількість не може бути більшою за доступну для "
"номенклатури {1}"

msgid ""
"Row #{0}: Returned quantity cannot be greater than available quantity to "
"return for Item {1}"
msgstr ""
"Рядок #{0}: Повернена кількість не може бути більшою за доступну для "
"повернення кількість номенклатури {1}"

msgid "Row #{0}: Secondary Item Qty cannot be zero"
msgstr "Рядок #{0}: кількість супутньої номенклатури не може дорівнювати нулю"

msgid ""
"Row #{0}: Selling rate for item {1} is lower than its {2}.\n"
"\t\t\t\t\tSelling {3} should be atleast {4}.<br><br>Alternatively,\n"
"\t\t\t\t\tyou can disable '{5}' in {6} to bypass\n"
"\t\t\t\t\tthis validation."
msgstr ""
"Рядок #{0}: Ціна продажу номенклатури {1} нижча за її {2}.\n"
"\t\t\t\t\t{3} продажу має бути щонайменше {4}.<br><br>Або\n"
"\t\t\t\t\tви можете вимкнути «{5}» у {6}, щоб обійти\n"
"\t\t\t\t\tцю перевірку."

msgid "Row #{0}: Sequence ID must be {1} or {2} for Operation {3}."
msgstr "Рядок #{0}: для операції {3} порядковий номер має бути {1} або {2}."

msgid "Row #{0}: Serial No {1} does not belong to Batch {2}"
msgstr "Рядок № {0}: Серійний номер {1} не належить до партії {2}"

msgid ""
"Row #{0}: Serial No {1} for Item {2} is not available in {3} {4} or might"
" be reserved in another {5}."
msgstr ""
"Рядок #{0}: Серійний номер {1} для номенклатури {2} недоступний у {3} {4}"
" або може бути зарезервований в іншому {5}."

msgid "Row #{0}: Serial No {1} is already selected."
msgstr "Рядок #{0}: серійний номер {1} уже вибрано."

msgid ""
"Row #{0}: Serial No {1} is not reserved against Sales Order {2}. Deliver "
"only the Serial Nos produced and reserved for it."
msgstr ""
"Рядок #{0}: серійний номер {1} не зарезервовано за замовленням на продаж "
"{2}. Відвантажуйте лише серійні номери, вироблені та зарезервовані для "
"нього."

msgid ""
"Row #{0}: Serial No(s) {1} are not a part of the linked Subcontracting "
"Inward Order. Please select valid Serial No(s)."
msgstr ""
"Рядок #{0}: серійних номерів {1} немає у пов’язаному вхідному замовленні "
"субпідряду. Виберіть коректні серійні номери."

msgid "Row #{0}: Service End Date cannot be before Invoice Posting Date"
msgstr ""
"Рядок #{0}: дата завершення послуги не може бути раніше дати проведення "
"рахунка"

msgid "Row #{0}: Service Start Date cannot be greater than Service End Date"
msgstr ""
"Рядок № {0}: дата початку служби не може бути більшою, ніж дата "
"закінчення служби"

msgid "Row #{0}: Service Start and End Date is required for deferred accounting"
msgstr ""
"Рядок № {0}: дата початку та закінчення послуги необхідна для "
"відкладеного обліку"

msgid "Row #{0}: Set Supplier for item {1}"
msgstr "Рядок #{0}: Встановіть постачальника для номенклатури {1}"

msgid ""
"Row #{0}: Since 'Track Semi Finished Goods' is enabled, the BOM {1} "
"cannot be used for Sub Assembly Items"
msgstr ""
"Рядок #{0}: оскільки ввімкнено «Відстежувати напівфабрикати», "
"специфікацію {1} не можна використовувати для номенклатури підзбірок"

msgid ""
"Row #{0}: Source Warehouse must be same as Customer Warehouse {1} from "
"the linked Subcontracting Inward Order"
msgstr ""
"Рядок #{0}: склад-джерело має збігатися зі складом клієнта {1} із "
"пов’язаного вхідного замовлення субпідряду"

msgid ""
"Row #{0}: Source Warehouse {1} for item {2} cannot be a customer "
"warehouse."
msgstr ""
"Рядок #{0}: Склад-джерело {1} для номенклатури {2} не може бути складом "
"клієнта."

msgid ""
"Row #{0}: Source Warehouse {1} for item {2} must be same as Source "
"Warehouse {3} in the Work Order."
msgstr ""
"Рядок #{0}: склад-джерело {1} для номенклатури {2} має збігатися зі "
"складом-джерелом {3} у замовленні на виробництво."

msgid ""
"Row #{0}: Source and Target Warehouse cannot be the same for Material "
"Transfer"
msgstr ""
"Рядок #{0}: для переміщення матеріалів склад-джерело і цільовий склад не "
"можуть збігатися"

msgid ""
"Row #{0}: Source, Target Warehouse and Inventory Dimensions cannot be the"
" exact same for Material Transfer"
msgstr ""
"Рядок #{0}: для переміщення матеріалів склад-джерело, цільовий склад і "
"складські виміри не можуть повністю збігатися"

msgid "Row #{0}: Start Time must be before End Time"
msgstr "Рядок #{0}: час початку має бути раніше часу завершення"

msgid "Row #{0}: Status is mandatory"
msgstr "Рядок #{0}: стан обов’язковий"

msgid "Row #{0}: Status must be {1} for Invoice Discounting {2}"
msgstr "Рядок № {0}: статус повинен бути {1} для знижок за рахунками {2}"

msgid ""
"Row #{0}: Stock cannot be reserved for Item {1} against a disabled Batch "
"{2}."
msgstr ""
"Рядок #{0}: Неможливо зарезервувати запас номенклатури {1} за вимкненою "
"партією {2}."

msgid "Row #{0}: Stock cannot be reserved for a non-stock Item {1}"
msgstr ""
"Рядок #{0}: Неможливо зарезервувати запас для нескладської номенклатури "
"{1}"

msgid ""
"Row #{0}: Stock cannot be reserved for the Item {1} as its delivery is "
"ensured based on the produced Serial Nos. The Work Order will reserve "
"them on manufacture."
msgstr ""
"Рядок #{0}: запаси для номенклатури {1} не можна зарезервувати, оскільки "
"її доставку забезпечено на основі вироблених серійних номерів. Замовлення"
" на виробництво зарезервує їх під час виготовлення."

msgid "Row #{0}: Stock cannot be reserved in group warehouse {1}."
msgstr "Рядок #{0}: запас не можна резервувати на груповому складі {1}."

msgid "Row #{0}: Stock is already reserved for the Item {1}."
msgstr "Рядок #{0}: Запас для номенклатури {1} вже зарезервовано."

msgid "Row #{0}: Stock is reserved for item {1} in warehouse {2}."
msgstr "Рядок #{0}: Запас номенклатури {1} зарезервовано на складі {2}."

msgid ""
"Row #{0}: Stock not available to reserve for Item {1} against Batch {2} "
"in Warehouse {3}."
msgstr ""
"Рядок #{0}: Запас номенклатури {1} за партією {2} на складі {3} "
"недоступний для резервування."

msgid ""
"Row #{0}: Stock not available to reserve for the Item {1} in Warehouse "
"{2}."
msgstr "Рядок #{0}: немає запасу для резервування номенклатури {1} на складі {2}."

msgid "Row #{0}: Stock quantity {1} ({2}) for item {3} cannot exceed {4}"
msgstr ""
"Рядок #{0}: Складська кількість {1} ({2}) для номенклатури {3} не може "
"перевищувати {4}"

msgid ""
"Row #{0}: Target Warehouse must be same as Customer Warehouse {1} from "
"the linked Subcontracting Inward Order"
msgstr ""
"Рядок #{0}: цільовий склад має збігатися зі складом клієнта {1} із "
"пов’язаного вхідного замовлення субпідряду"

msgid ""
"Row #{0}: Target Warehouse {1} must be a Transit warehouse when Add to "
"Transit is enabled."
msgstr ""
"Рядок #{0}: цільовий склад {1} має бути транзитним, коли ввімкнено "
"«Додати в транзит»."

msgid "Row #{0}: The batch {1} has already expired."
msgstr "Рядок № {0}: пакет {1} уже закінчився."

msgid ""
"Row #{0}: The operation {1} has 'Is Final Finished Good' checked, so its "
"FG / Semi FG Item must be {2}."
msgstr ""
"Рядок #{0}: для операції {1} позначено «Є кінцевою готовою продукцією», "
"тому її номенклатура готової продукції / напівфабрикату має бути {2}."

msgid ""
"Row #{0}: The warehouse {1} is not a child warehouse of a group warehouse"
" {2}"
msgstr "Рядок #{0}: склад {1} не є дочірнім для групового складу {2}"

msgid "Row #{0}: Timings conflicts with row {1}"
msgstr "Рядок #{0}: Конфлікт таймінгів з рядком {1}"

msgid ""
"Row #{0}: Total Number of Depreciations cannot be less than or equal to "
"Opening Number of Booked Depreciations"
msgstr ""
"Рядок #{0}: загальна кількість амортизацій має бути більшою за початкову "
"кількість нарахованих"

msgid "Row #{0}: Total Number of Depreciations must be greater than zero"
msgstr "Рядок #{0}: загальна кількість амортизацій має бути більшою за нуль"

msgid ""
"Row #{0}: Warehouse {1} does not match with the warehouse {2} in Serial "
"and Batch Bundle {3}."
msgstr ""
"Рядок #{0}: склад {1} не збігається зі складом {2} у наборі серійних "
"номерів і партій {3}."

msgid "Row #{0}: Withholding Amount {1} does not match calculated amount {2}."
msgstr "Рядок #{0}: сума утримання {1} не збігається з розрахованою {2}."

msgid "Row #{0}: Work Order exists against full or partial quantity of Item {1}"
msgstr ""
"Рядок #{0}: Для всієї або частини кількості номенклатури {1} вже є "
"замовлення на виробництво"

msgid ""
"Row #{0}: You cannot use the inventory dimension '{1}' in Stock "
"Reconciliation to modify the quantity or valuation rate. Stock "
"reconciliation with inventory dimensions is intended solely for "
"performing opening entries."
msgstr ""
"Рядок #{0}: Ви не можете використовувати вимір запасів '{1}' в "
"інвентаризації для зміни кількості або собівартості. Інвентаризація з "
"вимірами запасів призначена виключно для виконання початкових записів."

msgid "Row #{0}: You must select an Asset for Item {1}."
msgstr "Рядок #{0}: для номенклатури {1} треба вибрати актив."

msgid "Row #{0}: {1} account is not of type {2}"
msgstr "Рядок #{0}: рахунок {1} не належить типу {2}"

msgid "Row #{0}: {1} can not be negative for item {2}"
msgstr "Рядок #{0}: {1} не може бути від'ємним для номенклатури {2}"

msgid "Row #{0}: {1} is mandatory for the Inventory Dimension {2}."
msgstr "Рядок #{0}: {1} обов’язкове для складського виміру {2}."

msgid ""
"Row #{0}: {1} is not a valid reading field. Please refer to the field "
"description."
msgstr "Рядок #{0}: {1} не є коректним полем показника. Перегляньте опис поля."

msgid "Row #{0}: {1} is required to create the Opening {2} Invoices"
msgstr "Рядок № {0}: {1} необхідний для створення початкових {2} рахунків-фактур"

msgid ""
"Row #{0}: {1} of {2} should be {3}. Please update the {1} or select a "
"different account."
msgstr ""
"Рядок #{0}: {1} з {2} має бути {3}. Будь ласка, оновіть {1} або виберіть "
"інший рахунок."

msgid "Row #{0}:Quantity for Item {1} cannot be zero."
msgstr "Рядок #{0}: Кількість для номенклатури {1} не може бути нульовою."

msgid "Row #{1}: Warehouse is mandatory for stock Item {0}"
msgstr "Рядок #{1}: Склад обов'язковий для складської номенклатури {0}"

msgid ""
"Row #{idx}: Cannot select Supplier Warehouse while suppling raw materials"
" to subcontractor."
msgstr ""
"Рядок #{idx}: не можна вибирати склад постачальника, передаючи сировину "
"субпідряднику."

msgid ""
"Row #{idx}: Item rate has been updated as per valuation rate since its an"
" internal stock transfer."
msgstr ""
"Рядок #{idx}: Ціну позиції оновлено за собівартістю, оскільки це "
"внутрішнє переміщення запасів."

msgid "Row #{idx}: Please enter a location for the asset item {item_code}."
msgstr "Рядок #{idx}: вкажіть розташування для номенклатури активу {item_code}."

msgid ""
"Row #{idx}: Received Qty must be equal to Accepted + Rejected Qty for "
"Item {item_code}."
msgstr ""
"Рядок #{idx}: Отримана кількість має дорівнювати прийнятій + відхиленій "
"кількості для номенклатури {item_code}."

msgid "Row #{idx}: {field_label} can not be negative for item {item_code}."
msgstr ""
"Рядок #{idx}: {field_label} не може бути від'ємним для номенклатури "
"{item_code}."

msgid "Row #{idx}: {field_label} is mandatory."
msgstr "Рядок #{idx}: {field_label} обов’язкове."

msgid ""
"Row #{idx}: {from_warehouse_field} and {to_warehouse_field} cannot be "
"same."
msgstr ""
"Рядок #{idx}: {from_warehouse_field} і {to_warehouse_field} не можуть "
"збігатися."

msgid "Row #{idx}: {schedule_date} cannot be before {transaction_date}."
msgstr "Рядок #{idx}: {schedule_date} не може бути раніше за {transaction_date}."

