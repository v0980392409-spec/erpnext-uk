msgstr "Рядок #{idx}: вкажіть розташування для активу {item_code}."

msgid ""
"Row #{idx}: Received Qty must be equal to Accepted + Rejected Qty for "
"Item {item_code}."
msgstr ""
"Рядок #{idx}: отримана кількість має дорівнювати прийнятій плюс "
"відхиленій для номенклатури {item_code}."

msgid "Row #{idx}: {field_label} can not be negative for item {item_code}."
msgstr ""
"Рядок #{idx}: {field_label} не може бути від’ємним для номенклатури "
