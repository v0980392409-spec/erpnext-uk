msgid "Row #{}: The original Invoice {} of return invoice {} is not consolidated."
msgstr ""
"Рядок #{}: початковий рахунок {} для документа повернення {} не "
"консолідовано."

msgid ""
"Row #{}: You cannot add positive quantities in a return invoice. Please "
