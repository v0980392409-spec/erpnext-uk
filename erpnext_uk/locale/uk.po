msgstr ""
"Рядок {0}: Будь ласка, вкажіть дійсне посилання на позицію видаткової "
"накладної або упаковану номенклатуру."

msgid "Row {0}: Please select a BOM for Item {1}."
msgstr "Рядок {0}: виберіть специфікацію для номенклатури {1}."

msgid "Row {0}: Please select an active BOM for Item {1}."
msgstr "Рядок {0}: виберіть активну специфікацію для номенклатури {1}."

msgid "Row {0}: Please select an valid BOM for Item {1}."
msgstr "Рядок {0}: виберіть коректну специфікацію для номенклатури {1}."

msgid "Row {0}: Please set at Tax Exemption Reason in Sales Taxes and Charges"
msgstr ""
"Рядок {0}: вкажіть причину звільнення від податку в податках і зборах з "
