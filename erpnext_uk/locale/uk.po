msgid "Row {0}: Conversion Factor is mandatory"
msgstr "Рядок {0}: коефіцієнт перерахунку є обов’язковим"

msgid "Row {0}: Cost Center {1} does not belong to Company {2}"
msgstr "Рядок {0}: центр витрат {1} не належить організації {2}"

msgid "Row {0}: Cost center is required for an item {1}"
msgstr "Рядок {0}: для номенклатури {1} потрібен центр витрат"

msgid "Row {0}: Credit entry can not be linked with a {1}"
msgstr "Рядок {0}: запис про кредит не може бути пов'язаний з {1}"

msgid ""
"Row {0}: Currency of the BOM #{1} should be equal to the selected "
