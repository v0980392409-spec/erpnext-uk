msgstr ""
"Рядок {0}: серійні номери та партії скинуто до значень наряду на роботу "
"{1}, бо раніше вибрані до нього не належать."

msgid ""
"Row {0}: Shift cannot be changed since the depreciation has already been "
"processed"
msgstr "Рядок {0}: Змінність не можна змінити, оскільки амортизацію вже нараховано"

msgid "Row {0}: Subcontracted Item is mandatory for the raw material {1}"
msgstr "Рядок {0}: номенклатура субпідряду обов'язкова для сировини {1}"

msgid "Row {0}: Target Warehouse is mandatory for internal transfers"
msgstr "Рядок {0}: для внутрішніх переміщень обов’язковий цільовий склад"

msgid "Row {0}: Task {1} does not belong to Project {2}"
msgstr "Рядок {0}: завдання {1} не належить проєкту {2}"

msgid ""
"Row {0}: The entire expense amount for account {1} in {2} has already "
"been allocated."
msgstr "Рядок {0}: усю суму витрат за рахунком {1} у {2} вже розподілено."

msgid "Row {0}: The item {1}, quantity must be positive number"
msgstr "Рядок {0}: номенклатура {1}, кількість має бути додатним числом"

msgid "Row {0}: The {3} Account {1} does not belong to the company {2}"
msgstr "Рядок {0}: рахунок {3} {1} не належить організації {2}"

msgid ""
"Row {0}: To set {1} periodicity, difference between from and to date must"
" be greater than or equal to {2}"
msgstr ""
"Рядок {0}: щоб задати періодичність {1}, різниця між датами з і до має "
"бути не меншою за {2}"

msgid ""
"Row {0}: Transferred quantity cannot be greater than the requested "
"quantity."
msgstr "Рядок {0}: переміщена кількість не може перевищувати запитану."

msgid "Row {0}: UOM Conversion Factor is mandatory"
msgstr "Рядок {0}: коефіцієнт перерахунку одиниць виміру обов’язковий"

msgid ""
"Row {0}: Update Stock must be checked for item {1} because it is against "
"Pick List {2}."
msgstr ""
"Рядок {0}: Для номенклатури {1} потрібно позначити «Оновити запас», "
"оскільки вона відібрана за листом відбору {2}."

msgid "Row {0}: Warehouse is required"
msgstr "Рядок {0}: потрібен склад"

msgid ""
"Row {0}: Warehouse {1} is linked to company {2}. Please select a "
"warehouse belonging to company {3}."
msgstr ""
"Рядок {0}: склад {1} належить організації {2}. Виберіть склад організації"
" {3}."

msgid "Row {0}: Workstation or Workstation Type is mandatory for an operation {1}"
msgstr ""
"Рядок {0}: для операції {1} потрібно вказати робочий центр або тип "
"робочого центру"

msgid "Row {0}: user has not applied the rule {1} on the item {2}"
msgstr "Рядок {0}: користувач не застосував правило {1} до номенклатури {2}"

msgctxt "Financial Report Template"
msgid "Row {0}: {1}"
msgstr "Рядок {0}: {1}"

msgid "Row {0}: {1} account already applied for Accounting Dimension {2}"
msgstr "Рядок {0}: рахунок {1} уже застосовано для виміру обліку {2}"

msgid "Row {0}: {1} must be greater than 0"
msgstr "Рядок {0}: {1} має бути більше 0"

msgid "Row {0}: {1} {2} cannot be same as {3} (Party Account) {4}"
msgstr "Рядок {0}: {1} {2} не може збігатися з {3} (Рахунок контрагента) {4}"

msgid "Row {0}: {1} {2} does not match with {3}"
msgstr "Рядок {0}: {1} {2} не збігається з {3}"

