msgstr ""
"Рядок {0}: Статтю витрат змінено на {1}, оскільки для номенклатури {2} не"
" створено прибуткову накладну."

msgid ""
"Row {0}: Expense Head changed to {1} because account {2} is not linked to"
" warehouse {3} or it is not the default inventory account"
msgstr ""
"Рядок {0}: Статтю витрат змінено на {1}, оскільки рахунок {2} не "
"пов'язаний зі складом {3} або не є рахунком запасів за замовчуванням"

msgid ""
"Row {0}: Expense Head changed to {1} because expense is booked against "
"this account in Purchase Receipt {2}"
msgstr ""
"Рядок {0}: Статтю витрат змінено на {1}, оскільки витрати віднесено на "
"цей рахунок у прибутковій накладній {2}"

msgid "Row {0}: For Supplier {1}, Email Address is Required to send an email"
msgstr ""
"Рядок {0}: для постачальника {1} для надсилання електронного листа "
"потрібна електронна адреса"

msgid "Row {0}: From Time and To Time is mandatory."
msgstr "Рядок {0}: Поля «Час з» та «Час по» є обов’язковими"

msgid "Row {0}: From Time and To Time of {1} is overlapping with {2}"
msgstr "Рядок {0}: Час «від» та час «до» {1} перекривається з {2}"

msgid "Row {0}: From Warehouse is mandatory for internal transfers"
msgstr "Рядок {0}: для внутрішніх переміщень обов’язковий склад-джерело"

msgid "Row {0}: From time must be less than to time"
msgstr "Рядок {0}: час повинен бути меншим, ніж час"

msgid "Row {0}: Hours value must be greater than zero."
msgstr "Рядок {0}: Кількість годин має бути більшою за нуль."

msgid "Row {0}: Invalid reference {1}"
msgstr "Рядок {0}: Некоректне посилання {1}"

msgid "Row {0}: Item Tax template updated as per validity and rate applied"
msgstr ""
"Рядок {0}: Шаблон податку на номенклатуру оновлено відповідно до терміну "
"дії та застосованої ставки"

msgid ""
"Row {0}: Item rate has been updated as per valuation rate since its an "
