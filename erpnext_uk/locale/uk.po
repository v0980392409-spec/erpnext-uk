msgstr ""
"Рядок № {0}: дата початку служби не може бути більшою, ніж дата "
"закінчення служби"

msgid "Row #{0}: Service Start and End Date is required for deferred accounting"
msgstr ""
"Рядок № {0}: дата початку та закінчення послуги необхідна для "
"відкладеного обліку"

msgid "Row #{0}: Set Supplier for item {1}"
msgstr "Рядок №{0}: вкажіть постачальника для елементу {1}"

msgid ""
"Row #{0}: Since 'Track Semi Finished Goods' is enabled, the BOM {1} "
