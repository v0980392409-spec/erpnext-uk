msgstr ""
"Рядок #{0}: готову продукцію {1} не можна додавати в таблицю супутніх "
"позицій."

msgid "Row #{0}: Finished Good Item {1} must be a sub-contracted item"
msgstr "Рядок #{0}: готова продукція {1} має бути субпідрядною позицією"

msgid "Row #{0}: Finished Good must be {1}"
msgstr "Рядок #{0}: готовою продукцією має бути {1}"

msgid "Row #{0}: Finished Good reference is mandatory for Secondary Item {1}."
msgstr ""
"Рядок #{0}: для супутньої позиції {1} обов’язкове посилання на готову "
"продукцію."

msgid "Row #{0}: For Customer Provided Item {1}, Source Warehouse must be {2}"
msgstr ""
"Рядок #{0}: для давальницької номенклатури {1} складом-джерелом має бути "
"{2}"

msgid ""
"Row #{0}: For {1}, you can select reference document only if account gets"
" credited"
msgstr ""
"Рядок #{0}: для {1} документ-підставу можна вибрати, лише якщо рахунок "
"кредитується"

msgid ""
"Row #{0}: For {1}, you can select reference document only if account gets"
" debited"
msgstr ""
"Рядок #{0}: для {1} документ-підставу можна вибрати, лише якщо рахунок "
"дебетується"

msgid "Row #{0}: Frequency of Depreciation must be greater than zero"
msgstr "Рядок #{0}: періодичність амортизації має бути більшою за нуль"

msgid "Row #{0}: From Date cannot be before To Date"
msgstr "Рядок #{0}: дата з не може бути раніше дати до"

msgid "Row #{0}: From Time and To Time fields are required"
msgstr "Рядок #{0}: потрібні поля «Час з» і «Час до»"

msgid "Row #{0}: Item added"
msgstr "Рядок № {0}: елемент додано"

msgid "Row #{0}: Item {1} cannot be transferred more than {2} against {3} {4}"
msgstr ""
"Рядок #{0}: номенклатуру {1} не можна перемістити більше ніж {2} за {3} "
"{4}"

msgid "Row #{0}: Item {1} does not exist"
msgstr "Рядок #{0}: номенклатури {1} не існує"

msgid ""
"Row #{0}: Item {1} has been picked, please reserve stock from the Pick "
"List."
msgstr ""
"Рядок #{0}: номенклатуру {1} відібрано — резервуйте запас із листа "
"відбору."

msgid "Row #{0}: Item {1} has no stock in warehouse {2}."
msgstr "Рядок #{0}: номенклатури {1} немає на складі {2}."

msgid "Row #{0}: Item {1} has zero rate but '{2}' is not enabled."
msgstr "Рядок #{0}: у номенклатури {1} нульова ціна, а «{2}» не ввімкнено."

msgid "Row #{0}: Item {1} in warehouse {2}: Available {3}, Needed {4}."
msgstr "Рядок #{0}: номенклатура {1} на складі {2}: доступно {3}, потрібно {4}."

msgid "Row #{0}: Item {1} is not a Customer Provided Item."
msgstr "Рядок #{0}: номенклатура {1} не є давальницькою."

msgid ""
"Row #{0}: Item {1} is not a Serialized/Batched Item. It cannot have a "
"Serial No/Batch No against it."
msgstr ""
"Рядок № {0}: Пункт {1} не є серіалізованим / пакетним елементом. Він не "
"може мати серійний номер / номер партії проти нього."

msgid "Row #{0}: Item {1} is not a part of Subcontracting Inward Order {2}"
msgstr "Рядок #{0}: номенклатури {1} немає у вхідному замовленні субпідряду {2}"

msgid "Row #{0}: Item {1} is not a service item"
msgstr "Рядок #{0}: позиція {1} не є послугою"

msgid "Row #{0}: Item {1} is not a stock item"
msgstr "Рядок #{0}: позиція {1} не є складською"

msgid ""
"Row #{0}: Item {1} is not part of the source manufacture entry and cannot"
" be added to this disassembly."
msgstr ""
"Рядок #{0}: номенклатури {1} немає у вихідному виробничому русі, тож у це"
" розбирання її додати не можна."

msgid ""
"Row #{0}: Item {1} mismatch. Changing of item code is not permitted, add "
"another row instead."
msgstr ""
"Рядок #{0}: розбіжність номенклатури {1}. Змінювати код номенклатури не "
"дозволено — додайте окремий рядок."

msgid "Row #{0}: Item {1} mismatch. Changing of item code is not permitted."
msgstr ""
"Рядок #{0}: розбіжність номенклатури {1}. Змінювати код номенклатури не "
"дозволено."

msgid ""
"Row #{0}: Item {1} quantity ({2} in stock UOM) does not match the "
"quantity derived from the source ({3}). Do not change the UOM, conversion"
" factor or quantity of disassembly rows."
msgstr ""
"Рядок #{0}: кількість номенклатури {1} ({2} у складській одиниці) не "
"збігається з кількістю за вихідним документом ({3}). Не змінюйте одиницю,"
" коефіцієнт перетворення чи кількість у рядках розбирання."

msgid ""
"Row #{0}: Journal Entry {1} does not have account {2} or already matched "
"against another voucher"
msgstr ""
"Рядок №{0}: Бухгалтерська операція {1} не містить рахунку {2} або вже "
"зіставлена з іншим документом."

msgid "Row #{0}: Next Depreciation Date cannot be before Available-for-use Date"
msgstr ""
"Рядок #{0}: наступна дата амортизації не може бути раніше дати готовності"
" до використання"

msgid "Row #{0}: Next Depreciation Date cannot be before Purchase Date"
msgstr "Рядок #{0}: наступна дата амортизації не може бути раніше дати придбання"

msgid "Row #{0}: Not allowed to change Supplier as Purchase Order already exists"
msgstr ""
"Рядок №{0}: не можна змінювати постачальника, оскільки замовлення на "
"закупівлю вже існує"

msgid "Row #{0}: Only {1} available to reserve for the Item {2}"
msgstr "Рядок #{0}: для номенклатури {2} доступно для резервування лише {1}"

msgid ""
"Row #{0}: Opening Accumulated Depreciation must be less than or equal to "
"{1}"
msgstr "Рядок #{0}: початкова накопичена амортизація має бути не більшою за {1}"

msgid ""
"Row #{0}: Operation {1} is not completed for {2} qty of finished goods in"
" Work Order {3}. Please update operation status via Job Card {4}."
msgstr ""
"Рядок № {0}: Операція {1} не завершена для {2} кількості готової "
"продукції в робочому порядку {3}. Оновіть стан роботи за допомогою Job "
"Card {4}."

msgid ""
"Row #{0}: Overconsumption of Customer Provided Item {1} against Work "
"Order {2} is not allowed in the Subcontracting Inward process."
msgstr ""
"Рядок #{0}: у вхідному субпідряді перевитрата давальницької номенклатури "
"{1} за нарядом на роботу {2} не дозволена."

msgid "Row #{0}: Please select Item Code in Assembly Items"
msgstr "Рядок #{0}: виберіть код номенклатури у позиціях збірки"

msgid "Row #{0}: Please select the BOM No in Assembly Items"
msgstr "Рядок #{0}: виберіть номер специфікації у позиціях збірки"

msgid ""
"Row #{0}: Please select the Finished Good Item against which this "
"Customer Provided Item will be used."
msgstr ""
"Рядок #{0}: виберіть готову продукцію, для якої піде ця давальницька "
"номенклатура."

msgid "Row #{0}: Please select the Sub Assembly Warehouse"
msgstr "Рядок #{0}: виберіть склад підзбірки"

msgid "Row #{0}: Please set reorder quantity"
msgstr "Рядок №{0}: вкажіть кількість для повторного замовлення"

msgid ""
"Row #{0}: Please update deferred revenue/expense account in item row or "
"default account in company master"
msgstr ""
"Рядок #{0}: задайте рахунок доходів або витрат майбутніх періодів у рядку"
" позиції чи типовий рахунок у картці компанії"

msgid ""
"Row #{0}: Process Loss Percentage should be less than 100% for {1} Item "
"{2}"
msgstr ""
"Рядок #{0}: відсоток технологічних втрат має бути меншим за 100% для {1},"
" номенклатура {2}"

msgid "Row #{0}: Qty increased by {1}"
msgstr "Рядок #{0}: кількість збільшено на {1}"

msgid "Row #{0}: Qty must be a positive number"
msgstr "Рядок #{0}: кількість має бути додатною"

msgid ""
"Row #{0}: Qty should be less than or equal to Available Qty to Reserve "
"(Actual Qty - Reserved Qty) {1} for Iem {2} against Batch {3} in "
"Warehouse {4}."
msgstr ""
"Рядок #{0}: кількість має бути не більшою за доступну для резервування "
"(фактична мінус зарезервована) {1} для номенклатури {2} за партією {3} на"
" складі {4}."

msgid "Row #{0}: Quality Inspection is required for Item {1}"
msgstr "Рядок #{0}: для номенклатури {1} потрібна перевірка якості"

msgid "Row #{0}: Quality Inspection {1} is not submitted for the item: {2}"
msgstr "Рядок #{0}: перевірку якості {1} для номенклатури {2} не проведено"

msgid "Row #{0}: Quality Inspection {1} was rejected for item {2}"
msgstr "Рядок #{0}: перевірку якості {1} для номенклатури {2} не пройдено"

msgid ""
"Row #{0}: Quantity cannot be a non-positive number. Please increase the "
"quantity or remove the Item {1}"
msgstr ""
"Рядок #{0}: кількість має бути додатною. Збільшіть кількість або "
"приберіть номенклатуру {1}"

msgid "Row #{0}: Quantity for Item {1} cannot be zero."
msgstr "Рядок #{0}: кількість позиції {1} не може бути нульовою."

msgid "Row #{0}: Quantity must be greater than 0 for Item {1}"
msgstr "Рядок #{0}: кількість номенклатури {1} має бути більшою за 0"

msgid ""
"Row #{0}: Quantity of Item {1} cannot be more than {2} {3} against "
"Subcontracting Inward Order {4}"
msgstr ""
"Рядок #{0}: кількість номенклатури {1} за вхідним замовленням субпідряду "
"{4} не може перевищувати {2} {3}"

msgid "Row #{0}: Quantity to reserve for the Item {1} should be greater than 0."
msgstr ""
"Рядок #{0}: кількість для резервування номенклатури {1} має бути більшою "
