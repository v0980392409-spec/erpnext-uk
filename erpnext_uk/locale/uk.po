msgstr "Рядок {0}: Валюта в специфікації {1} не відповідає вибраній валюті {2}"

msgid "Row {0}: Debit entry can not be linked with a {1}"
msgstr "Рядок {0}: Дебетовий запис не може бути пов’язаний із {1}"

msgid ""
"Row {0}: Delivery Warehouse ({1}) and Customer Warehouse ({2}) can not be"
" same"
msgstr ""
"Рядок {0}: склад відвантаження ({1}) і склад клієнта ({2}) не можуть "
"збігатися"

msgid ""
"Row {0}: Delivery Warehouse cannot be same as Customer Warehouse for Item"
