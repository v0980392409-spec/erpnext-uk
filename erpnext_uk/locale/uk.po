msgid "Row #{0}: Rate must be same as {1}: {2} ({3} / {4})"
msgstr "Рядок №{0}: ставка/ціна має збігатися з {1}: {2} ({3} / {4})"

msgid ""
"Row #{0}: Reading {1} {2} is not a valid number in the {3} number format."
" Use {4} as the decimal separator."
msgstr ""
"Рядок #{0}: показник {1} {2} не є коректним числом у форматі {3}. "
