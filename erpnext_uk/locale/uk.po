msgstr ""
"Рядок #{0}: склад-джерело {1} для номенклатури {2} не може бути складом "
"клієнта."

msgid ""
"Row #{0}: Source Warehouse {1} for item {2} must be same as Source "
"Warehouse {3} in the Work Order."
msgstr ""
"Рядок #{0}: склад-джерело {1} для номенклатури {2} має збігатися зі "
"складом-джерелом {3} у наряді на роботу."

msgid ""
"Row #{0}: Source and Target Warehouse cannot be the same for Material "
"Transfer"
msgstr ""
"Рядок #{0}: для переміщення матеріалів склад-джерело і цільовий склад не "
"можуть збігатися"

msgid ""
"Row #{0}: Source, Target Warehouse and Inventory Dimensions cannot be the"
