msgstr "Рядок #{0}: склад {1} не є дочірнім для групового складу {2}"

msgid "Row #{0}: Timings conflicts with row {1}"
msgstr "Рядок #{0}: Конфлікт таймінгів з рядком {1}"

msgid ""
"Row #{0}: Total Number of Depreciations cannot be less than or equal to "
