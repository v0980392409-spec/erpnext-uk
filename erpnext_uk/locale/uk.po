msgstr ""
"Рядок #{0}: запас номенклатури {1} не можна зарезервувати за вимкненою "
"партією {2}."

msgid "Row #{0}: Stock cannot be reserved for a non-stock Item {1}"
msgstr "Рядок #{0}: запас не можна зарезервувати для нескладської номенклатури {1}"

msgid "Row #{0}: Stock cannot be reserved in group warehouse {1}."
msgstr "Рядок #{0}: запас не можна резервувати на груповому складі {1}."

msgid "Row #{0}: Stock is already reserved for the Item {1}."
msgstr "Рядок #{0}: запас номенклатури {1} уже зарезервовано."

msgid "Row #{0}: Stock is reserved for item {1} in warehouse {2}."
msgstr "Рядок #{0}: запаси номенклатури {1} зарезервовано на складі {2}."

msgid ""
"Row #{0}: Stock not available to reserve for Item {1} against Batch {2} "
