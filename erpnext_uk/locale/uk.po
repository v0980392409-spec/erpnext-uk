msgid "Row {0}: Activity Type is mandatory."
msgstr "Рядок {0}: Тип робіт є обов'язковим."

msgid "Row {0}: Advance against Customer must be credit"
msgstr "Рядок {0}: Сума авансу від клієнта має бути в колонці «Кредит»"

msgid "Row {0}: Advance against Supplier must be debit"
msgstr "Рядок {0}: аванс постачальнику має бути дебетом"

msgid ""
"Row {0}: Allocated amount {1} must be less than or equal to invoice "
