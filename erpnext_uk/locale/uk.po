msgstr ""
"Рядок #{0}: для переміщення матеріалів склад-джерело, цільовий склад і "
"складські виміри не можуть повністю збігатися"

msgid "Row #{0}: Start Time must be before End Time"
msgstr "Рядок #{0}: час початку має бути раніше часу завершення"

msgid "Row #{0}: Status is mandatory"
msgstr "Рядок #{0}: стан обов’язковий"

msgid "Row #{0}: Status must be {1} for Invoice Discounting {2}"
msgstr "Рядок № {0}: статус повинен бути {1} для знижок за рахунками {2}"

msgid ""
"Row #{0}: Stock cannot be reserved for Item {1} against a disabled Batch "
