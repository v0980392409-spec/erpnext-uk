msgid ""
"Row {0}: Allocated amount {1} must be less than or equal to remaining "
"payment amount {2}"
msgstr "Рядок {0}: розподілена сума {1} має бути не більшою за залишок платежу {2}"

msgid ""
"Row {0}: As {1} is enabled, raw materials cannot be added to {2} entry. "
"Use {3} entry to consume raw materials."
msgstr ""
"Рядок {0}: оскільки ввімкнено {1}, сировину не можна додавати в документ "
"{2}. Списуйте сировину документом {3}."

msgid "Row {0}: Bill of Materials not found for the Item {1}"
msgstr "Рядок {0}: Відомість матеріалів не знайдено для елемента {1}"

msgid "Row {0}: Both Debit and Credit values cannot be zero"
msgstr "Рядок {0}: дебет і кредит не можуть бути нульовими одночасно"

msgid "Row {0}: Cannot sell item {1} from Sample Retention Warehouse {2}"
msgstr ""
"Рядок {0}: номенклатуру {1} не можна продати зі складу зберігання зразків"
" {2}"

msgid "Row {0}: Conversion Factor is mandatory"
msgstr "Рядок {0}: коефіцієнт перерахунку є обов’язковим"

msgid "Row {0}: Cost Center {1} does not belong to Company {2}"
msgstr "Рядок {0}: центр витрат {1} не належить компанії {2}"

msgid "Row {0}: Cost center is required for an item {1}"
msgstr "Рядок {0}: для пункту {1} потрібен центр витрат."

msgid "Row {0}: Credit entry can not be linked with a {1}"
msgstr "Рядок {0}: запис про кредит не може бути пов'язаний з {1}"

msgid ""
"Row {0}: Currency of the BOM #{1} should be equal to the selected "
"currency {2}"
msgstr "Рядок {0}: Валюта в специфікації {1} не відповідає вибраній валюті {2}"

msgid "Row {0}: Debit entry can not be linked with a {1}"
msgstr "Рядок {0}: Дебетовий запис не може бути пов’язаний із {1}"

msgid ""
"Row {0}: Delivery Warehouse ({1}) and Customer Warehouse ({2}) can not be"
