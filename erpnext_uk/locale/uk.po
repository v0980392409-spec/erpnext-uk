msgstr ""
"Рядок #{}: у документі повернення не можна вказувати додатну кількість. "
"Приберіть позицію {}, щоб завершити повернення."

msgid "Row #{}: item {} has been picked already."
msgstr "Рядок #{}: номенклатуру {} вже відібрано."

msgid "Row #{}: {}"
msgstr "Рядок № {}: {}"

msgid "Row #{}: {} {} does not exist."
msgstr "Рядок № {}: {} {} не існує."

msgid "Row #{}: {} {} doesn't belong to Company {}. Please select valid {}."
msgstr "Рядок #{}: {} {} не належить компанії {}. Виберіть коректне значення {}."

msgid ""
"Row No {0}: Warehouse is required. Please set a Default Warehouse for "
"Item {1} and Company {2}"
msgstr ""
"Рядок {0}: потрібен склад. Задайте типовий склад для номенклатури {1} і "
