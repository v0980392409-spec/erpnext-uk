msgid ""
"Row {0}: Expense Account {1} is linked to company {2}. Please select an "
"account belonging to company {3}."
msgstr ""
"Рядок {0}: рахунок витрат {1} належить організації {2}. Виберіть рахунок "
"організації {3}."

msgid ""
"Row {0}: Expense Head changed to {1} as no Purchase Receipt is created "
