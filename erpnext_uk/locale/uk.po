msgid "Row {0}: Please set the Mode of Payment in Payment Schedule"
msgstr "Рядок {0}: вкажіть спосіб оплати у графіку платежів"

msgid "Row {0}: Please set the correct code on Mode of Payment {1}"
msgstr "Рядок {0}: Введіть правильний код у спосіб оплати {1}"

msgid "Row {0}: Project must be same as the one set in the Timesheet: {1}."
msgstr "Рядок {0}: проєкт має збігатися з проєктом у табелі: {1}."

msgid "Row {0}: Purchase Invoice {1} has no stock impact."
msgstr "Рядок {0}: рахунок на покупку {1} не впливає на залишки."

msgid "Row {0}: Qty cannot be greater than {1} for the Item {2}."
msgstr "Рядок {0}: Кількість не може бути більшою за {1} для номенклатури {2}."

msgid "Row {0}: Qty in Stock UOM can not be zero."
msgstr "Рядок {0}: кількість у складській одиниці не може дорівнювати нулю."

msgid "Row {0}: Qty must be greater than 0."
msgstr "Рядок {0}: кількість має бути більшою за 0."

msgid "Row {0}: Quantity cannot be negative."
msgstr "Рядок {0}: кількість не може бути від’ємною."

msgid ""
"Row {0}: Quantity not available for {4} in warehouse {1} at posting time "
"of the entry ({2} {3})"
msgstr ""
"Рядок {0}: Кількість недоступна для {4} на складі {1} під час публікації "
"запису ({2} {3})"

msgid "Row {0}: Sales Invoice {1} is already created for {2}"
msgstr "Рядок {0}: рахунок-фактуру (продаж) {1} для {2} вже створено"

msgid ""
"Row {0}: Serial/Batch has been reset to values linked with Work Order {1}"
" because the previously selected serial/batch does not belong to this "
